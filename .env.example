OPENAI_API_KEY=<OPENAI_API_KEY>
# Optional: defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Rate limiting (Upstash Redis). Required in production; optional locally,
# where an in-memory limiter is used when these are unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional: total chat requests allowed per day across all visitors (default 500)
# CHAT_GLOBAL_DAILY_LIMIT=500
